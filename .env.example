# Local synthetic mode. Copy to .env. Never put .env in Git.
MODE=mock
PUBLIC_MCP_URL=http://127.0.0.1:8000/mcp
SHAREPOINT_HOST=example.sharepoint.com
REGISTRY_PATH=config/mock-sites.json
FIXTURES_PATH=fixtures
MOCK_TOKENS_PATH=.local/mock_tokens.json
MAX_FILE_BYTES=10485760
MAX_TEXT_CHARS=60000
MAX_PDF_PAGES=100
MAX_SCAN_ITEMS=2000
MAX_SEARCH_RESULTS=25
MAX_SITES_PER_CALL=10
MAX_PAGES_PER_COLLECTION=100
REQUEST_SECONDS=150
GRAPH_TIMEOUT_SECONDS=20
EXTRACTION_SECONDS=20
MAX_CONCURRENT_TOOLS=4
GRAPH_PAGE_SIZE=100
