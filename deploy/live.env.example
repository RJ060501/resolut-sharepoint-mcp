# Installed as /etc/resolut-mcp/live.env, owner root, group resolut-mcp, mode 0640.
# Replace every placeholder locally. These are NOT real tenant values.
MODE=live
PUBLIC_MCP_URL=https://mcp.REPLACE_WITH_VERIFIED_DOMAIN/mcp
SHAREPOINT_HOST=REPLACE_WITH_TENANT.sharepoint.com
TENANT_ID=REPLACE_WITH_TENANT_GUID
API_CLIENT_ID=REPLACE_WITH_API_APP_CLIENT_GUID
CLAUDE_CLIENT_ID=REPLACE_WITH_CLAUDE_CLIENT_APP_GUID
API_CLIENT_SECRET=REPLACE_WITH_API_APP_SECRET_VALUE
# Alternative: remove API_CLIENT_SECRET and use a registered certificate:
# API_CERTIFICATE_PATH=/etc/resolut-mcp/api-private-key.pem
# API_CERTIFICATE_THUMBPRINT=REPLACE_WITH_CERTIFICATE_THUMBPRINT
REGISTRY_PATH=/etc/resolut-mcp/sites.json
# Exact hosts only. Start with the tenant host. Add any legitimate extra download
# host only after administrator verification; never use *.sharepoint.com.
DOWNLOAD_HOSTS=REPLACE_WITH_TENANT.sharepoint.com
MAX_FILE_BYTES=10485760
MAX_TEXT_CHARS=60000
MAX_PDF_PAGES=100
MAX_SCAN_ITEMS=2000
MAX_SEARCH_RESULTS=25
MAX_SITES_PER_CALL=10
MAX_PAGES_PER_COLLECTION=100
REQUEST_SECONDS=150
GRAPH_TIMEOUT_SECONDS=20
EXTRACTION_SECONDS=20
MAX_CONCURRENT_TOOLS=4
GRAPH_PAGE_SIZE=100
